# -----------------------------------------------------------------------------
# Sensitive and generated research data
# -----------------------------------------------------------------------------
/data/**
!/data/.gitkeep

# Training outputs, predictions, metrics, and model checkpoints
/artifacts/**
!/artifacts/.gitkeep

# Generated reports and visualizations
/reports/*.md
/reports/figures/**
/reports/*.zip
/reports/*.tar
/reports/*.tar.gz

# -----------------------------------------------------------------------------

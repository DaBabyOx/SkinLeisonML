# -----------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.keras
*.tflite
*.safetensors
*.pkl
*.pickle
*.joblib

# Generated numerical and tabular caches
*.npy
*.npz
*.parquet
*.feather
*.arrow

# Archives and downloaded bundles
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# -----------------------------------------------------------------------------
